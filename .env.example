# Copy this file to .env for local development. Never commit .env.

# --- Azure Storage (photos in Blob Storage, records in Table Storage) ---
# For local testing with the Azurite emulator, keep the line below as is
# (it is Microsoft's public, documented emulator key, not a real secret).
# For real Azure, replace it with the connection string from
# Azure portal > your storage account > Security + networking > Access keys.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;
AZURE_STORAGE_CONTAINER=crop-photos
AZURE_STORAGE_TABLE=CropPhotos

# --- Azure Translator (advice, alerts and missing UI text in the chosen language) ---
# Leave empty to show advice in English.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia

# --- Azure AI Speech (read advice aloud) ---
# Free F0 tier: 0.5 million characters a month. Leave empty to use the phone's own voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# --- Usage and feedback records (same storage account, used by /stats) ---
AZURE_STORAGE_EVENTS_TABLE=AppEvents

# --- Server ---
# Any long random text. Keeps read-aloud links valid across restarts and workers.
# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=8000
